
def node_risk(state: GraphState) -> dict:
    risk = risk_for_intent(state["intent"]).value
    route = route_for_intent(state["intent"])
    logger.info("risk checked: intent=%s risk=%s route=%s", state["intent"], risk, route)
    return {"risk": risk, "route": route, "current_step": "Risk Checked"}


def node_account(state: GraphState) -> dict:
    cid = state["customer_id"]
    if state["intent"] == "balance":
        account = account_agent.account_summary(cid)
        response = f"Your available {account['type'].lower()} balance is ₹{account['balance']:,.2f}."
        return {"agent": "Account Agent", "response": response, "current_step": "Completed"}
    txns = account_agent.transactions(cid)
    return {"agent": "Account Agent", "response": txns, "current_step": "Completed", "context": {"last_transactions": txns}}


def node_loan(state: GraphState) -> dict:
    loan = loan_agent.loan_summary(state["customer_id"])
    if not loan or loan.get("loan_type") == "No active loan":
        response = "You don't have an active loan on this account."
    else:
        response = f"Your {loan['loan_type']} EMI is ₹{loan['emi']:,}, due {loan['next_due']}. {loan['remaining']} instalments remain."
    return {"agent": "Loan Agent", "response": response, "current_step": "Completed"}


def node_rag(state: GraphState) -> dict:
    result = rag_agent.answer(state["message"])
    logger.info(
        "rag retrieval: confidence=%.3f route=%s groq_used=%s",
        result.get("confidence") or 0.0, result.get("route"), result.get("route") == "RAG Agent",
    )
    return {
        "agent": "RAG Agent",
        "response": result["answer"],
        "rag_confidence": result.get("confidence"),
        "current_step": "Escalated" if result.get("conflict") else "Completed",
    }


def node_card(state: GraphState) -> dict:
    cid = state["customer_id"]
    if state["intent"] == "cards":
        return {"agent": "Card Agent", "response": card_agent.cards(cid), "current_step": "Completed"}

    last4 = extract_last4(state["message"])

    if state["intent"] == "card_active_check":
        if not last4:
            return {"agent": "Card Agent", "response": "Which card would you like to check? Please share the last 4 digits.", "current_step": "Awaiting Card Number"}
        card = card_agent.lookup(cid, last4)
        if not card:
            return {"agent": "Card Agent", "response": f"I couldn't find a card ending {last4} on your account.", "current_step": "Card Not Found"}
        if card["status"] == "ACTIVE":
            response = f"Yes. Your card ending {last4} is currently active."
        else:
            response = f"No. Your card ending {last4} is currently {card['status'].lower()}."
        return {"agent": "Card Agent", "response": response, "current_step": "Completed"}

    result = card_agent.handle(cid, state["intent"], last4)
    return {
        "agent": "Card Agent",
        "response": result["response"],
        "current_step": result["current_step"],
        "agent_result": result,
        "ownership": result.get("ownership", "N/A"),
        "authorization": result.get("authorization", "N/A"),
    }


def node_dispute_investigate(state: GraphState) -> dict:
    cid = state["customer_id"]
    message = state["message"]
    amount = extract_amount(message)
    issue = classify_dispute_issue(message)

    if amount is not None:
        result = dispute_agent.lookup(cid, amount)
        matches = result["matches"]
        if not matches:
            # A legitimate "I see a debit I can't find on my statement"
            # report — never fabricate a transaction to attach it to, but
            # also never silently reject it. This is exactly the scenario
            # the dispute process exists for; it proceeds after an explicit
            # confirmation, same as any other dispute. Recent/unrelated
            # transactions are never shown here — an explicit amount means
            # only an exact match (or no match) is relevant.
            last4 = extract_last4(message)
            card_label = f"****{last4}" if last4 else None
            txn_label = "ATM transaction" if issue == ISSUE_ATM_CASH else "transaction"
            response = (
                f"I can help you report this as an unrecognized/failed-transaction case. "
                f"I couldn't find a matching ₹{amount:,.0f} {txn_label} in your current transaction records.\n\n"
                "Would you like to raise a dispute for this debit?"
            )
            debug_fields = {
                "agent": "Dispute Agent",
                "response": response,
                "current_step": "Awaiting Confirmation",
                "risk": "HIGH",
                "route": "Dispute Agent",
                "ownership": "PASSED",
                "authorization": "PASSED",
                "transaction_match": "NOT_FOUND",
                "amount": amount,
                "confirmation": "REQUIRED",
                "agent_result": {
                    "no_match_dispute": True,
                    "amount": amount,
                    "card_last4": last4,
                    "issue": issue,
                },
            }
            if card_label:
                debug_fields["card"] = card_label
            return debug_fields
    else:
        # No amount stated (e.g. "I was charged twice", "the transaction
        # failed but money was deducted") — offer the customer's recent
        # transactions as candidates instead of refusing outright.
        matches = account_agent.transactions(cid)
        if not matches:
            return {"agent": "Dispute Agent", "response": "I couldn't find any transactions on your account to dispute.", "current_step": "No Match"}

    if len(matches) > 1:
        listing = "\n".join(f"- {t['merchant']} · ₹{t['amount']:,} · {t['date']} · {t['id']}" for t in matches)
        return {
            "agent": "Dispute Agent",
            "response": f"I found multiple matching transactions:\n\n{listing}\n\nPlease reply with the transaction ID.",
            "current_step": "Multiple Matches",
            "agent_result": {"candidates": matches},
        }

    txn = matches[0]
    existing = dispute_agent.by_transaction(cid, txn["id"])
    if existing:
        return {"agent": "Dispute Agent", "response": f"This transaction already has an open dispute: {existing['id']} ({existing['status']}).", "current_step": "Already Disputed"}

    return {
        "agent": "Dispute Agent",
        "response": f"I found one matching transaction:\n\n{txn['merchant']} · ₹{txn['amount']:,} · {txn['date']} · {txn['status']}\nTransaction ID: {txn['id']}\n\nWhat seems to be wrong with this transaction?",
        "current_step": "Awaiting Issue Type",
        "agent_result": {"transaction": txn},
    }


def node_dispute_status(state: GraphState) -> dict:
    disputes = dispute_agent.status(state["customer_id"])
    response = disputes if disputes else "I couldn't find an open dispute for your account."
    return {"agent": "Dispute Agent", "response": response, "current_step": "Completed"}


def node_complaint(state: GraphState) -> dict:
    return {
        "agent": "Complaint Agent",
        "response": "I can help file a complaint. Please describe the issue in your next message.",
        "current_step": "Awaiting Description",
    }


def node_fallback(state: GraphState) -> dict:
    intent = state["intent"]
    if intent == "money_transfer":
        response = "I can't perform money transfers through this assistant. Please use the bank's secure banking channel."
        step = "Refused - Irreversible Action"
    elif intent == "change_pin":
        response = "I can't change your PIN through this assistant. Please use the bank's secure banking channel."
        step = "Refused - Irreversible Action"
    else:
        response = "I can help with banking-related questions such as accounts, transactions, cards, loans and disputes. Could you rephrase your question, or contact a bank representative for further help?"
        step = "Unrouted"
        intent = "out_of_scope"
    return {"agent": "Fallback / Escalation", "response": response, "current_step": step, "intent": intent}


def node_guardrails(state: GraphState) -> dict:
    response = state.get("response")
    if response in (None, ""):
        response = "I couldn't safely process that request. Please contact a bank representative."
    return {"response": response, "guardrail": "PASSED"}


def route_decision(state: GraphState) -> str:
    route = state["route"]
    if route == "Dispute Agent":
        return "dispute_status" if state["intent"] == "dispute_status" else "dispute_investigate"
    return {
        "Account Agent": "account",
        "Loan Agent": "loan",
        "RAG Agent": "rag",
        "Card Agent": "card",
        "Complaint Agent": "complaint",
    }.get(route, "fallback")


def _build_graph():
    graph = StateGraph(GraphState)
    graph.add_node("classify", node_classify)
    graph.add_node("risk", node_risk)
    graph.add_node("account", node_account)
    graph.add_node("loan", node_loan)
    graph.add_node("rag", node_rag)
    graph.add_node("card", node_card)
    graph.add_node("dispute_investigate", node_dispute_investigate)
    graph.add_node("dispute_status", node_dispute_status)
    graph.add_node("complaint", node_complaint)
    graph.add_node("fallback", node_fallback)
    graph.add_node("guardrails", node_guardrails)

    graph.add_edge(START, "classify")
    graph.add_edge("classify", "risk")
    graph.add_conditional_edges("risk", route_decision, {
        "account": "account",
        "loan": "loan",
        "rag": "rag",
        "card": "card",
        "dispute_investigate": "dispute_investigate",
        "dispute_status": "dispute_status",
        "complaint": "complaint",
        "fallback": "fallback",
    })
    for leaf in ["account", "loan", "rag", "card", "dispute_investigate", "dispute_status", "complaint", "fallback"]:
        graph.add_edge(leaf, "guardrails")
    graph.add_edge("guardrails", END)
    return graph.compile()


_compiled = _build_graph()


def _run_classified(message: str, customer_id: str, context: dict | None = None) -> dict:
    """Fresh classify → risk → agent run (no pending workflow in progress).

    Before classifying, check whether this message is a deterministic
    follow-up about transactions we already showed this conversation
    ("which one was the biggest?") — answered from structured context, not
    by re-classifying or asking an LLM.
    """
    followup = account_agent.answer_transaction_followup(message, context)
    if followup:
        response, new_context = followup
        return {
            "agent": "Account Agent",
            "response": response,
            "current_step": "Completed",
            "intent": "transaction_followup",
            "risk": Risk.READ.value,
            "route": "Account Agent",
            "guardrail": "PASSED",
            "context": new_context,
        }
    state: GraphState = {"message": message, "customer_id": customer_id, "context": context or {}}
    result = _compiled.invoke(state)
    return dict(result)


def _handle_pending(message: str, customer_id: str, pending: dict, context: dict | None = None) -> dict:
    """Continuations of a multi-turn action (card number, dispute issue,
    complaint description, picking among multiple transaction matches).

    These are UI navigation steps, not a fresh intent to classify — banking
    state itself still lives in the mock banking API / SQLite, never in
    chat history. However, a message that clearly represents a brand new,
    high-risk intent (e.g. "Transfer ₹50,000 to Rahul" while a complaint
    description was pending) must be allowed to interrupt and route fresh
    instead of being swallowed as the pending workflow's answer.
    """
    ptype = pending.get("type")

    if ptype == "card_last4":
        intent = pending.get("intent", "block_card")
        # A reply here is only "the card number" if it doesn't itself look
        # like a brand new request. Checking this before (not only when)
        # last4 extraction fails means a message like "unauthorized
        # transaction on card 4321" — which *does* contain a 4-digit
        # number — still interrupts instead of being swallowed as this
        # pending card-number answer.
        new_intent = classify_intent(message)
        if new_intent not in ("fallback", intent):
            return _run_classified(message, customer_id, context)
        last4 = extract_last4(message)
        if not last4:
            return {"response": "I didn't catch the card number. Please share the last 4 digits.", "current_step": "Awaiting Card Number", "agent": "Card Agent", "route": "Card Agent", "risk": risk_for_intent(intent).value, "intent": intent}
        result = card_agent.handle(customer_id, intent, last4)
        if pending.get("amount"):
            result["carry_amount"] = pending["amount"]
        return {
            "response": result["response"],
            "current_step": result["current_step"],
            "agent": "Card Agent",
            "route": "Card Agent",
            "risk": risk_for_intent(intent).value,
            "agent_result": result,
            "intent": intent,
            "ownership": result.get("ownership", "N/A"),
            "authorization": result.get("authorization", "N/A"),
        }

    if ptype == "dispute_pick":
        candidates = pending.get("candidates", [])
        tid = extract_transaction_id(message)
        txn = next((t for t in candidates if t["id"] == tid), None)
        if not txn:
            if classify_intent(message) != "fallback":
                return _run_classified(message, customer_id, context)
            return {"response": "I couldn't match that to one of the transactions listed. Please reply with the exact transaction ID.", "current_step": "Multiple Matches", "agent": "Dispute Agent", "route": "Dispute Agent", "risk": risk_for_intent("dispute_status").value, "agent_result": {"candidates": candidates}}
        existing = dispute_agent.by_transaction(customer_id, txn["id"])
        if existing:
            return {"response": f"This transaction already has an open dispute: {existing['id']} ({existing['status']}).", "current_step": "Already Disputed", "agent": "Dispute Agent", "route": "Dispute Agent", "risk": risk_for_intent("dispute_status").value}
        return {"response": f"Transaction ID: {txn['id']}\n\nWhat seems to be wrong with this transaction?", "current_step": "Awaiting Issue Type", "agent": "Dispute Agent", "route": "Dispute Agent", "risk": risk_for_intent("dispute_status").value, "agent_result": {"transaction": txn}}

    if ptype == "dispute_issue":
        if classify_intent(message) in INTERRUPT_INTENTS:
            return _run_classified(message, customer_id, context)
        txn = pending["transaction"]
        return {
            "response": f"Please confirm: raise a dispute for {txn['merchant']} · ₹{txn['amount']:,} · {txn['id']}\nIssue: {message}",
            "current_step": "Awaiting Confirmation",
            "agent": "Dispute Agent",
            "route": "Dispute Agent",
            "risk": risk_for_intent("raise_dispute").value,
            "agent_result": {"transaction": txn, "issue": message},
        }

    if ptype == "complaint_description":
        if classify_intent(message) in INTERRUPT_INTENTS:
            return _run_classified(message, customer_id, context)
        return {
            "response": f"Please confirm: file a complaint with description:\n\n\"{message}\"",
            "current_step": "Awaiting Confirmation",
            "agent": "Complaint Agent",
            "route": "Complaint Agent",
            "risk": risk_for_intent("raise_complaint").value,
            "agent_result": {"description": message},
        }

    return {"response": "Something went wrong tracking this conversation step. Please start over.", "current_step": "Error"}


def run_graph(message: str, customer_id: str, pending: dict | None = None, context: dict | None = None) -> dict:
    if pending:
        return _handle_pending(message, customer_id, pending, context)
    return _run_classified(message, customer_id, context)


# Friendly, intent-specific sign-in nudges for a public (unauthenticated)
# visitor who asks for something that requires a session. Anything not
# listed here gets a generic nudge.
SIGN_IN_NUDGES = {
    "balance": "I can check your account balance, but you'll need to sign in first.",
    "transactions": "I can show your transactions, but you'll need to sign in first.",
    "cards": "I can show your cards, but you'll need to sign in first.",
    "card_active_check": "I can check your card status, but you'll need to sign in first.",
    "block_card": "I can block your card, but you'll need to sign in first.",
    "unblock_card": "I can unblock your card, but you'll need to sign in first.",
    "card_lost_stolen": "I can help block a lost or stolen card, but you'll need to sign in first.",
    "loan": "I can show your loan/EMI details, but you'll need to sign in first.",
    "dispute_status": "I can show your disputes, but you'll need to sign in first.",
    "transaction_investigation": "I can help raise a dispute, but you'll need to sign in first.",
    "raise_complaint": "I can help file a complaint, but you'll need to sign in first.",
}


def run_public_graph(message: str) -> dict:
    """Unauthenticated entry point: only READ/RAG policy questions are ever
    answered without a session. Everything else — even a READ-tier intent
    like 'balance' that reads personal data — gets a natural sign-in nudge
    instead of a routing error. The LLM never decides this; it's a plain
    lookup against the same deterministic risk/route tables used for
    authenticated chat."""
    intent = classify_intent(message)
    if intent == "fallback":
        from llm.groq_client import classify_intent_llm
        llm_intent = classify_intent_llm(message)
        if llm_intent:
            intent = llm_intent

    risk = risk_for_intent(intent).value
    route = route_for_intent(intent)

    if route == "RAG Agent":
        result = rag_agent.answer(message)
        return {
            "access": "PUBLIC",
            "authentication": "NOT_REQUIRED",
            "intent": "POLICY_QUERY",
            "risk": Risk.READ.value,
            "agent": "RAG Agent",
            "route": route,
            "response": result["answer"],
            "rag_confidence": result.get("confidence"),
            "rag_threshold": get_settings().rag_threshold,
            "rag_source": result.get("source"),
            "groq": "USED" if result.get("route") == "RAG Agent" else "NOT CALLED",
            "current_step": "Escalated" if result.get("conflict") else "Completed",
        }

    if intent in ("money_transfer", "change_pin", "fallback"):
        fallback = node_fallback({"intent": intent})
        return {
            "access": "PUBLIC",
            "authentication": "NOT_REQUIRED",
            "intent": fallback["intent"],
            "risk": risk,
            "agent": "Fallback / Escalation",
            "route": "Fallback / Escalation",
            "response": fallback["response"],
            "current_step": fallback["current_step"],
        }

    nudge = SIGN_IN_NUDGES.get(intent, "I'll need you to sign in before I can help with that — it involves your personal account information.")
    return {
        "access": "PUBLIC",
        "authentication": "NOT_REQUIRED",
        "intent": intent,
        "risk": risk,
        "agent": route,
        "route": route,
        "response": nudge,
        "requires_auth": True,
        "current_step": "Sign-In Required",
    }
