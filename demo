def sparkline(points, color):
    """Render a tiny static SVG sparkline given a list of y-values (0-100)."""
    w, h, pad = 200, 28, 3
    n = len(points)
    step = (w - 2 * pad) / (n - 1)
    lo, hi = min(points), max(points)
    rng = (hi - lo) or 1
    coords = []
    for i, p in enumerate(points):
        x = pad + i * step
        y = pad + (1 - (p - lo) / rng) * (h - 2 * pad)
        coords.append(f"{x:.1f},{y:.1f}")
    path = " ".join(coords)
    area = f"{pad},{h-pad} " + path + f" {w-pad},{h-pad}"
    return (
        f'<svg class="spark" viewBox="0 0 {w} {h}" preserveAspectRatio="none">'
        f'<polyline points="{area}" fill="{color}" opacity="0.10" stroke="none"/>'
        f'<polyline points="{path}" fill="none" stroke="{color}" stroke-width="2" '
        f'stroke-linecap="round" stroke-linejoin="round"/>'
        f'</svg>'
    )


